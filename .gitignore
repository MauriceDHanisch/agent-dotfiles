# Exclude all runtime data and secrets across all tools
*/.git
*/.tmp
*/cache
*/history
*/logs
*/sessions
*/telemetry
*/tmp

# Specific exclusions
claude/.claude/.credentials.json
gemini/.gemini/google_accounts.json
gemini/.gemini/oauth_creds.json
codex/.codex/auth.json
codex/.codex/*.sqlite*

# Muse local-only / machine state (never commit)
muse/.config/muse/auth.json
muse/.config/muse/trust.json
muse/.config/muse/settings.json
muse/.config/muse/skills/
muse/.config/muse/*.lock

# Cursor local-only / machine state (never symlink or commit)
cursor/.cursor/projects/
cursor/.cursor/chats/
cursor/.cursor/ai-tracking/
cursor/.cursor/skills-cursor/
cursor/.cursor/sandbox-policies/
cursor/.cursor/agent-cli-state.json
cursor/.cursor/statsig-cache.json
cursor/.cursor/cli-config.json
cursor/.cursor/statusline.last.json

# Root level
.DS_Store
*.token
*.log
